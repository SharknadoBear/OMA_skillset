{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ciofs:point-request:v1",
  "title": "CIOFS point request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "start_utc", "end_utc_exclusive", "guidance", "points"],
  "properties": {
    "schema_version": {"const": "ciofs_point_request_v1"},
    "start_utc": {"type": "string", "format": "date-time"},
    "end_utc_exclusive": {"type": "string", "format": "date-time"},
    "guidance": {"enum": ["nowcast", "forecast"]},
    "run_cycle_utc": {"type": "string", "format": "date-time"},
    "variables": {
      "type": "array", "minItems": 1,
      "items": {"enum": ["u", "v", "salt", "temp", "zeta", "currents", "salinity", "temperature", "water_level"]},
      "default": ["u", "v"]
    },
    "vertical_views": {
      "type": "array", "minItems": 1, "default": ["surface"],
      "items": {"type": "string", "pattern": "^(surface|near_surface|bottom|index:[0-9]+)$"}
    },
    "minimum_depth_m": {"type": "number", "minimum": 0, "maximum": 11000, "default": 0},
    "missing_policy": {"enum": ["error", "skip"], "default": "error"},
    "min_completeness": {"type": "number", "minimum": 0, "maximum": 1, "default": 0.95},
    "max_gap_hours": {"type": ["number", "null"], "minimum": 1, "default": null},
    "max_workers": {"type": "integer", "minimum": 1, "maximum": 8, "default": 4},
    "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300, "default": 60},
    "retries": {"type": "integer", "minimum": 1, "maximum": 8, "default": 4},
    "points": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/point"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"guidance": {"const": "forecast"}}},
      "then": {"required": ["run_cycle_utc"]},
      "else": {"not": {"required": ["run_cycle_utc"]}}
    }
  ],
  "$defs": {
    "point": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "latitude", "longitude"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "latitude": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude": {"type": "number", "minimum": -180, "maximum": 180},
        "sampling": {"enum": ["nearest_wet", "bilinear"], "default": "nearest_wet"},
        "max_distance_m": {"type": "number", "exclusiveMinimum": 0, "default": 5000},
        "required": {"type": "boolean", "default": true}
      }
    }
  },
  "$comment": "The runtime also enforces unique point IDs; paired U/V; timezone-aware hour alignment; increasing [start,end); 00/06/12/18 UTC forecast cycles and 1..48 h forecast valid times; finite numeric values; valid native sigma indices; and geometric/data quality gates."
}
