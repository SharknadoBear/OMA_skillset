{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pnnl.gov/oma/schemas/gmsh-fvcom-case-v1.json",
  "title": "Research Gmsh FVCOM case manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "display_name",
    "execution_order",
    "experiment_status",
    "domain_type",
    "projected_crs",
    "boundary",
    "bathymetry",
    "budget",
    "sizing",
    "readiness"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": "gmsh_fvcom_case_v1"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "execution_order": {
      "type": "integer",
      "minimum": 1,
      "maximum": 6
    },
    "experiment_status": {
      "const": "proposed"
    },
    "domain_type": {
      "enum": [
        "coastal_open",
        "closed_lake",
        "cyclic_offshore"
      ]
    },
    "projected_crs": {
      "type": [
        "string",
        "null"
      ]
    },
    "boundary": {
      "$ref": "#/$defs/boundary"
    },
    "bathymetry": {
      "$ref": "#/$defs/bathymetry"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "archived_mesh_quality_json": {
          "$ref": "#/$defs/pathOrNull"
        },
        "comparison_policy": {
          "const": "metric_by_metric_no_composite_winner"
        }
      }
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "sizing": {
      "$ref": "#/$defs/sizing"
    },
    "preparation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readiness": {
      "$ref": "#/$defs/readiness"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "pathOrNull": {
      "type": [
        "string",
        "null"
      ]
    },
    "openBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "cyclic",
        "orientation"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "cyclic": {
          "type": "boolean"
        },
        "orientation": {
          "type": "string",
          "minLength": 1
        },
        "selection": {
          "type": "string"
        }
      }
    },
    "negativeFixture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "expected_result",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "expected_result": {
          "const": "reject"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_kind",
        "resolution_manifest",
        "model_boundary_loops_gpkg",
        "model_boundary_loop_manifest",
        "expected_open_boundary_count",
        "open_boundaries",
        "expected_island_holes",
        "preserve_source_vertices",
        "allow_gmsh_boundary_insertion",
        "negative_rejection_fixtures"
      ],
      "properties": {
        "input_kind": {
          "enum": [
            "adaptive_v2",
            "model_loops_v1"
          ]
        },
        "resolution_manifest": {
          "$ref": "#/$defs/pathOrNull"
        },
        "model_boundary_loops_gpkg": {
          "$ref": "#/$defs/pathOrNull"
        },
        "model_boundary_loop_manifest": {
          "$ref": "#/$defs/pathOrNull"
        },
        "expected_open_boundary_count": {
          "type": "integer",
          "minimum": 0
        },
        "open_boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/openBoundary"
          }
        },
        "expected_island_holes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "preserve_source_vertices": {
          "const": true
        },
        "allow_gmsh_boundary_insertion": {
          "const": true
        },
        "negative_rejection_fixtures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/negativeFixture"
          }
        },
        "required_revalidation": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "build_policy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "bathymetry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "netcdf",
        "source_policy",
        "coverage_requirement",
        "status"
      ],
      "properties": {
        "netcdf": {
          "$ref": "#/$defs/pathOrNull"
        },
        "source_policy": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "coverage_requirement": {
          "type": "string"
        },
        "status": {
          "enum": [
            "available",
            "missing"
          ]
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preflight_node_threshold",
        "hard_node_cap",
        "hu_increment_m",
        "overflow_reruns"
      ],
      "properties": {
        "preflight_node_threshold": {
          "const": 135000
        },
        "hard_node_cap": {
          "const": 150000
        },
        "hu_increment_m": {
          "const": 25
        },
        "overflow_reruns": {
          "const": 1
        }
      }
    },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "near_obc_size_m",
        "near_obc_distance_m",
        "far_obc_distance_m",
        "bathymetry_floor_multiplier",
        "bathymetry_floor_roundup_m"
      ],
      "properties": {
        "mode": {
          "enum": [
            "obc_distance_threshold",
            "uniform"
          ]
        },
        "near_obc_size_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "near_obc_distance_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "far_obc_distance_m": {
          "type": [
            "number",
            "null"
          ]
        },
        "bathymetry_floor_multiplier": {
          "const": 3
        },
        "bathymetry_floor_roundup_m": {
          "const": 25
        }
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "boundary_status",
        "bathymetry_status",
        "blockers"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "blocked_missing_bathymetry",
            "blocked_boundary_rebuild",
            "blocked_boundary_build"
          ]
        },
        "boundary_status": {
          "enum": [
            "available",
            "conditional_revalidation",
            "missing"
          ]
        },
        "bathymetry_status": {
          "enum": [
            "available",
            "missing"
          ]
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
