{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oma.local/schemas/roms_movie_manifest_v1.json",
  "title": "ROMS movie manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "created_utc", "status", "warnings", "inputs", "request",
    "resolved", "grid", "selection", "fixed_color_limits", "coverage", "rendering",
    "frames", "output", "report_path"
  ],
  "properties": {
    "schema_version": {"const": "roms_movie_manifest_v1"},
    "created_utc": {"type": "string", "pattern": "Z$"},
    "status": {"enum": ["pass", "pass_with_warnings"]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "inputs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "size_bytes", "sha256", "raw_record_count", "geometry_sha256", "input_kind", "input_schema_version"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "size_bytes": {"type": "integer", "minimum": 1},
          "sha256": {"$ref": "#/$defs/sha256"},
          "raw_record_count": {"type": "integer", "minimum": 1},
          "geometry_sha256": {"$ref": "#/$defs/sha256"},
          "input_kind": {"enum": ["raw", "compact", "unclassified"]},
          "input_schema_version": {"type": ["string", "null"]}
        }
      }
    },
    "request": {
      "type": "object",
      "required": ["variable", "layer", "start_utc", "end_utc_exclusive"],
      "properties": {
        "variable": {"type": "string", "minLength": 1},
        "layer": {"type": "string", "minLength": 1},
        "start_utc": {"type": ["string", "null"]},
        "end_utc_exclusive": {"type": ["string", "null"]}
      }
    },
    "resolved": {
      "type": "object",
      "required": ["requested_variable", "layer", "source_variables", "normalized_cadence_seconds", "snap_tolerance_seconds", "input_kind", "input_schema_version", "angle_units", "angle_convention"]
    },
    "grid": {
      "type": "object",
      "required": ["shape", "wet_cell_count", "geometry_sha256", "Vtransform", "Vstretching", "angle_units", "angle_convention"],
      "properties": {
        "shape": {"$ref": "#/$defs/gridShape"},
        "wet_cell_count": {"type": "integer", "minimum": 1},
        "geometry_sha256": {"$ref": "#/$defs/sha256"},
        "Vtransform": {"type": ["integer", "null"]},
        "Vstretching": {"type": ["integer", "null"]},
        "angle_units": {"const": "radians"},
        "angle_convention": {"const": "xi_axis_counterclockwise_from_east"}
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "frame_count", "first_time_utc", "last_time_utc", "unique_monotonic",
        "duplicate_times_removed", "distinct_rendered_frame_count", "snap_tolerance_seconds"
      ],
      "properties": {
        "frame_count": {"type": "integer", "minimum": 1},
        "first_time_utc": {"type": "string", "pattern": "Z$"},
        "last_time_utc": {"type": "string", "pattern": "Z$"},
        "unique_monotonic": {"const": true},
        "duplicate_times_removed": {"type": "integer", "minimum": 0},
        "distinct_rendered_frame_count": {"type": "integer", "minimum": 1},
        "snap_tolerance_seconds": {"type": "number", "minimum": 0}
      }
    },
    "fixed_color_limits": {
      "type": "object",
      "required": ["method", "vmin", "vmax", "quantiles_percent"],
      "properties": {
        "method": {"enum": ["explicit", "full_series_quantiles"]},
        "vmin": {"type": "number"},
        "vmax": {"type": "number"},
        "quantiles_percent": {"anyOf": [{"$ref": "#/$defs/pair"}, {"type": "null"}]}
      }
    },
    "coverage": {
      "type": "object",
      "required": ["minimum_finite_wet_fraction", "mean_finite_wet_fraction", "all_nan_frame_count"],
      "properties": {
        "minimum_finite_wet_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "mean_finite_wet_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "all_nan_frame_count": {"const": 0}
      }
    },
    "rendering": {
      "type": "object",
      "required": [
        "format", "fps_requested", "frame_duration_ms", "cmap", "dpi",
        "figure_size_inches", "movie_quivers", "temporary_frames_cleaned"
      ],
      "properties": {
        "format": {"const": "GIF"},
        "fps_requested": {"type": "number", "exclusiveMinimum": 0},
        "frame_duration_ms": {"type": "integer", "minimum": 1},
        "cmap": {"type": "string", "minLength": 1},
        "dpi": {"type": "integer", "minimum": 40},
        "figure_size_inches": {"$ref": "#/$defs/pair"},
        "movie_quivers": {"const": false},
        "temporary_frames_cleaned": {"const": true}
      }
    },
    "frames": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "index", "time_utc", "original_time_utc", "normalization_offset_seconds",
          "finite_wet_fraction", "source", "source_record_index", "rendered_frame_sha256"
        ],
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "time_utc": {"type": "string", "pattern": "Z$"},
          "original_time_utc": {"type": "string", "pattern": "Z$"},
          "normalization_offset_seconds": {"type": "number"},
          "finite_wet_fraction": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "source": {"type": "string", "minLength": 1},
          "source_record_index": {"type": "integer", "minimum": 0},
          "rendered_frame_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["path", "size_bytes", "sha256", "frame_count", "pixel_size", "frame_duration_ms_observed"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "frame_count": {"type": "integer", "minimum": 1},
        "pixel_size": {"$ref": "#/$defs/gridShape"},
        "frame_duration_ms_observed": {"type": "integer", "minimum": 1}
      }
    },
    "report_path": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pair": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "gridShape": {
      "type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}],
      "minItems": 2, "maxItems": 2
    }
  }
}
